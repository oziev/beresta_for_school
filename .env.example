# Beresta — локальная разработка в Docker

# --- Core ---
APP_NAME=Beresta
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-please-change-it
LOG_LEVEL=DEBUG

# --- Database (для Docker — имя сервиса, НЕ localhost!) ---
DATABASE_URL=postgresql+asyncpg://beresta:beresta@postgres:5432/beresta

# --- Redis (для Docker — имя сервиса, НЕ localhost!) ---
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL_SEC=86400

# --- HTTP / CORS ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- GigaChat (заглушка для теста) ---
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat
GIGACHAT_AUTHORIZATION_KEY=

# Включи заглушку, если нет доступа к GigaChat
BERESTA_LLM_STUB=true
LLM_TIMEOUT_SEC=30
LLM_CACHE_TTL_SEC=3600