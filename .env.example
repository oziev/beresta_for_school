# Beresta — локальная разработка (скопируйте в `.env` в корне репозитория или в `backend/`).

# --- Core ---
APP_NAME=Beresta
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- Database (async SQLAlchemy + asyncpg) ---
# Docker Compose (сервис `app` внутри сети): хост `postgres`, порт 5432
DATABASE_URL=postgresql+asyncpg://beresta:beresta@localhost:5432/beresta

# --- Redis (кэш LLM + сессии QR) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SEC=86400

# --- HTTP / CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# --- GigaChat (Sber) — ключи только из окружения ---
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat
# Опционально: готовый Basic-токен (base64 от client_id:client_secret)
GIGACHAT_AUTHORIZATION_KEY=

# Если true — всегда локальный stub вместо реального GigaChat
BERESTA_LLM_STUB=false
LLM_TIMEOUT_SEC=30
LLM_CACHE_TTL_SEC=3600
